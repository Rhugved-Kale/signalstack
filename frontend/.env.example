# Base URL of the SignalStack API, with no trailing slash.
#
# Local development (the API started with backend/start.sh or uvicorn):
VITE_API_URL=http://localhost:8000
#
# Production: set this in the Vercel project's Environment Variables to the
# Render service URL, e.g.
#   VITE_API_URL=https://signalstack-api.onrender.com
#
# Vite inlines VITE_* variables at BUILD time, not run time — changing this in
# Vercel requires a redeploy for it to take effect.
