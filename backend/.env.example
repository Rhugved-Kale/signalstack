# SQLAlchemy connection string for the Postgres instance (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://signalstack:signalstack@localhost:5432/signalstack

# Comma-separated list of browser origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Deployment environment name; surfaced by GET /health.
ENVIRONMENT=local
